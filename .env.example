# Copy to .env and fill in. .env is git-ignored; this file carries names only (D37).
#
#   cp .env.example .env

# MyMemory REST API (D68). No key required for 1000 req/day (5000 words).
# Set this to your email to raise the daily limit to 10 000 words.
# (Field name kept for .env compatibility; no longer a secret credential.)
GOOGLE_TRANSLATE_API_KEY=

# --- Optional overrides -------------------------------------------------
# Everything below has a default in speech_translator/config.py. Uncomment
# only to override on one machine.

# Derived from the D25 latency budget — read D25 before changing either.
# ST_SILENCE_THRESHOLD_MS=600
# ST_MAX_UTTERANCE_MS=4000

# Written in by docs/BENCHMARK.md at Level 3. Leave unset until then (D20).
# ST_MODEL_SIZE=
# ST_COMPUTE_TYPE=

# Where Whisper weights are cached; pinned so the first-run download is
# findable (D41).
# ST_MODEL_CACHE_DIR=

# Server. Port is config, not a literal — "port already in use" is on the
# D41 register.
# ST_HOST=127.0.0.1
# ST_PORT=8000

# Default target language for captions.
# ST_TARGET_LANG=en
